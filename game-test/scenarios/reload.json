{
  "name": "/mar reload reloads config.json",
  "steps": [
    { "on": "Alice", "action": "chat", "text": "/mar reload" },
    { "on": "Alice", "action": "wait_for_log", "pattern": "\\[CHAT\\] config\\.json を再読み込みしました。", "timeout": 10 },
